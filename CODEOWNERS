/plugins/modules/role_team_assignment.py             @ansible/platform-collection-stewards @ansible/gateway-pdt @ansible/controller-pdt @ansible/eda-pdt @ansible/hub-pdt
/plugins/action/role_team_assignment.py              @ansible/platform-collection-stewards @ansible/gateway-pdt @ansible/controller-pdt @ansible/eda-pdt @ansible/hub-pdt
