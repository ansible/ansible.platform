---
exclude_paths:
  - 'changelogs/'
  # base_action.py is an internal base class, not a user-facing action plugin
  - 'plugins/action/base_action.py'
  # Molecule inventory files are dicts, not playbooks; avoid syntax-check playbook rule
  - 'extensions/molecule/default/inventory.yml'
  - 'extensions/molecule/inventory.yml'
  - 'extensions/molecule/organization_mock/inventory.yml'
  - 'extensions/molecule/job_template_mock/inventory.yml'
  - 'extensions/molecule/users_mock/inventory.yml'
- changelogs/
- plugins/action/base_action.py
- extensions/molecule/default/inventory.yml
- extensions/molecule/inventory.yml
- extensions/molecule/organization_mock/inventory.yml
- extensions/molecule/users_mock/inventory.yml
- extensions/molecule/schedule_mock/inventory.yml
  - changelogs/
  - plugins/action/base_action.py
  - extensions/molecule/default/inventory.yml
  - extensions/molecule/inventory.yml
  - extensions/molecule/organization_mock/inventory.yml
  - extensions/molecule/users_mock/inventory.yml
  - extensions/molecule/schedule_mock/inventory.yml
profile: production
use_default_rules: true
...
